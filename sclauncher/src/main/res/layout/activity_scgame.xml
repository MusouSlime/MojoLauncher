<?xml version="1.0" encoding="utf-8"?>
<!-- Game screen: full-screen render surface + edge buttons.
     The Legend of Dragoon-themed on-screen controller (TouchGamepadView) is
     added at runtime and replaces the in-game mobile-controls mod; empty-area
     touches fall through to the game as a mouse (menus/UI).
     - keyboardButton (LEFT): summons the soft keyboard for name entry. In
       Handheld Mode the IME is also raised automatically while the game has a
       text field focused (SDL_TextInputActive polling).
     - exitButton (TOP CENTER): return to the launcher. Hidden in Handheld
       Mode, where a single BACK returns instead.
     Buttons are brought to front after every visibility sync so the pad and
     fullscreen surface cannot swallow their touches. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/gameSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Hidden IME target (SDLTextInputView): the soft keyboard types here and
         each committed change is forwarded to the game as an SDL text-input
         event (nativeCommitText), which is what the game's text fields read.
         Mojo's SDL text-input path is stubbed, so the game can never summon a
         keyboard by itself. 2dp, transparent, focusable — never visible. -->
    <com.severedchains.launcher.ui.SDLTextInputView
        android:id="@+id/gameKeyboardInput"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:cursorVisible="false"
        android:textColor="@android:color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:importantForAutofill="noExcludeDescendants" />

    <!-- Virtual-keyboard button (name entry etc.): pinned to the LEFT edge,
         always visible (plain "KB" text so it renders on every device). -->
    <Button
        android:id="@+id/keyboardButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="8dp"
        android:alpha="0.6"
        android:text="KB"
        android:textSize="16sp" />

    <!-- Return to the launcher. Bottom-right corner, next to the eye toggle.
         Hidden in Handheld Mode (single BACK exits). -->
    <Button
        android:id="@+id/exitButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.6"
        android:minWidth="72dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Exit"
        android:textSize="14sp" />

    <!-- Hide/show the on-screen controls (handheld: clear the screen to watch
         the game). Always visible so the controls can be brought back. -->
    <ImageButton
        android:id="@+id/eyeButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.6"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Hide controls"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_eye" />
</FrameLayout>
