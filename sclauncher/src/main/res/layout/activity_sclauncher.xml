<?xml version="1.0" encoding="utf-8"?>
<!-- Setup screen (SCLauncherActivity): status readouts + Launch + a single
     dropdown menu (☰ Menu) holding every other action (re-check, import,
     discs, JRE, saves, mods, log). All logic lives in the activity;
     this file is layout only. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lod_bg"
    android:padding="16dp"
    tools:context=".SCLauncherActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/lod_panel"
            android:padding="18dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severed Chains Launcher"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/lod_gold"
                android:letterSpacing="0.05"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/lod_border"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking game files..."
                android:textSize="16sp"
                android:textColor="@color/lod_cream"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/jreStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/lod_dim"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="4dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/downloadStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#A9C4E8"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/launchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Launch Severed Chains"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/lod_button_text"
                android:enabled="false"
                android:background="@drawable/lod_button_primary"
                app:backgroundTint="@null"
                android:paddingHorizontal="48dp"
                android:paddingVertical="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Every other action lives in this dropdown menu. -->
            <Button
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☰  Menu"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/lod_cream"
                android:background="@drawable/lod_button"
                app:backgroundTint="@null"
                android:paddingHorizontal="32dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp" />

            <!-- Renderer is automatic (Mali -> native GLES + probe, Snapdragon
                 -> native GLES); this line only reports the auto-selected mode. -->
            <TextView
                android:id="@+id/gpuModeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPU: detecting..."
                android:textSize="14sp"
                android:textColor="@color/lod_gold"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
