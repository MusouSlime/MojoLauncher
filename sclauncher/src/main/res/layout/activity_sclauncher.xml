<?xml version="1.0" encoding="utf-8"?>
<!-- Setup screen (SCLauncherActivity): status readouts, JRE install/import,
     per-disc image pickers, launch button. All logic lives in the activity;
     this file is layout only. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".SCLauncherActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severed Chains Launcher"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking game files..."
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/jreStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="4dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/downloadStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#AAAAFF"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/launchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Launch Severed Chains"
                android:textSize="18sp"
                android:enabled="false"
                android:paddingHorizontal="48dp"
                android:paddingVertical="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/searchAgainButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Again"
                android:textSize="14sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/sendLogButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send Log"
                android:textSize="14sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/downloadJreButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download JRE 25"
                android:textSize="14sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disc images (your files, your mapping):"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/pickDisc1Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disc 1"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/pickDisc2Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disc 2"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/pickDisc3Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disc 3"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/pickDisc4Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disc 4"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp" />

            </LinearLayout>

            <Button
                android:id="@+id/importJreButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import JRE"
                android:textSize="14sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/exportSavesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export Saves"
                    android:textSize="14sp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/importSavesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Import Saves"
                    android:textSize="14sp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
