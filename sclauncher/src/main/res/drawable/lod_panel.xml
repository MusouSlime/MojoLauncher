<?xml version="1.0" encoding="utf-8"?>
<!-- Legend of Dragoon menu panel: deep translucent indigo fill inside a
     steel-blue frame (like the in-game options/menu windows). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8FB0DA" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#D9061226" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
