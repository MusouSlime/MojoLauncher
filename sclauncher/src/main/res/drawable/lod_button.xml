<?xml version="1.0" encoding="utf-8"?>
<!-- Legend of Dragoon menu entry: indigo panel with a steel-blue border,
     gold border on press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#20365E" />
            <stroke android:width="2dp" android:color="#E4C170" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12203F" />
            <stroke android:width="2dp" android:color="#8FB0DA" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
